{
  "info": {
    "name": "Warehouse API",
    "description": "API for managing products in a warehouse",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "id", "value": "456" },
    { "key": "businessUnitCode", "value": "MWH.001" }
  ],
  "item": [
    {
      "name": "List all warehouse units",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/warehouse",
          "host": ["{{baseUrl}}"],
          "path": ["warehouse"]
        },
        "description": "Returns a list of warehouse units (200)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Create a new warehouse unit",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"456\",\n  \"businessUnitCode\": \"MWH.001\",\n  \"location\": \"AMSTERDAM-001\",\n  \"capacity\": 100,\n  \"stock\": 50\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/warehouse",
          "host": ["{{baseUrl}}"],
          "path": ["warehouse"]
        },
        "description": "Creates a warehouse unit. Responses: 201 created, 400 invalid request parameters."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 201', () => pm.response.to.have.status(201));"]
          }
        }
      ]
    },
    {
      "name": "Get a warehouse unit by ID",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/warehouse/:id",
          "host": ["{{baseUrl}}"],
          "path": ["warehouse", ":id"],
          "variable": [
            { "key": "id", "value": "{{id}}", "description": "ID of the warehouse unit to get" }
          ]
        },
        "description": "Responses: 200 found, 404 not found."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    },
    {
      "name": "Archive a warehouse unit by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/warehouse/:id",
          "host": ["{{baseUrl}}"],
          "path": ["warehouse", ":id"],
          "variable": [
            { "key": "id", "value": "{{id}}", "description": "ID of the warehouse unit to archive" }
          ]
        },
        "description": "Responses: 204 archived, 404 not found."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 204', () => pm.response.to.have.status(204));"]
          }
        }
      ]
    },
    {
      "name": "Replace the current active Warehouse",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"456\",\n  \"businessUnitCode\": \"MWH.001\",\n  \"location\": \"AMSTERDAM-001\",\n  \"capacity\": 100,\n  \"stock\": 50\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/warehouse/:businessUnitCode/replacement",
          "host": ["{{baseUrl}}"],
          "path": ["warehouse", ":businessUnitCode", "replacement"],
          "variable": [
            {
              "key": "businessUnitCode",
              "value": "{{businessUnitCode}}",
              "description": "Business unit code of the warehouse unit to replace"
            }
          ]
        },
        "description": "Archives the current active Warehouse with this Business Unit Code and creates the new one in its place. Responses: 200 replaced, 404 not found, 400 invalid request parameters."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"]
          }
        }
      ]
    }
  ]
}